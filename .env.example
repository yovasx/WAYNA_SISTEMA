# ============================================================
#  WAYNA — Variables de entorno
#  Copia este archivo: cp .env.example .env
#  El entrypoint genera APP_KEY automáticamente
# ============================================================

APP_NAME=WAYNA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9090
APP_TIMEZONE=America/La_Paz

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Base de datos ─────────────────────────────────────────
# Nota: dentro del contenedor el host es "wayna_postgres"
# Desde tu máquina local conéctate en localhost:5433
DB_CONNECTION=pgsql
DB_HOST=wayna_postgres
DB_PORT=5432
DB_DATABASE=wayna
DB_USERNAME=wayna_user
DB_PASSWORD=wayna_secret

# ── Redis ─────────────────────────────────────────────────
# Dentro del contenedor: wayna_redis:6379
# Desde tu máquina: localhost:6380
REDIS_HOST=wayna_redis
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# ── Caché, sesiones y colas → Redis ──────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ── Broadcasting (opcional, para futuras notificaciones) ──
BROADCAST_CONNECTION=log

# ── Mail (configura según necesites) ─────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@wayna.bo"
MAIL_FROM_NAME="${APP_NAME}"

# ── pgAdmin ───────────────────────────────────────────────
PGADMIN_EMAIL=admin@wayna.local
PGADMIN_PASSWORD=admin123

# ── Vite ─────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
